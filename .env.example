# ISNM Environment Configuration
# Copy this file to .env and fill in your values

APP_ENV=production
APP_DEBUG=false

# System Database (all ERP data: students, staff, finance, ICT, payroll)
SYSTEM_DB_HOST=localhost
SYSTEM_DB_PORT=3306
SYSTEM_DB_NAME=igangaschool_system
SYSTEM_DB_USER=igangaschool_system
SYSTEM_DB_PASS=

# Website Database
WEBSITE_DB_HOST=localhost
WEBSITE_DB_PORT=3306
WEBSITE_DB_NAME=igangaschool_website
WEBSITE_DB_USER=igangaschool_website
WEBSITE_DB_PASS=

# Database Charset
DB_CHARSET=utf8mb4

# Hosting Credentials (cPanel auto-connect, used as fallback when .env creds fail)
# If set, these override the built-in defaults per database name.
# DB_IGANGA_SYSTEM_USER=
# DB_IGANGA_SYSTEM_PASS=
# DB_IGANGA_WEBSITE_USER=
# DB_IGANGA_WEBSITE_PASS=
# DB_IGANGAOFL_SYSTEM_USER=
# DB_IGANGAOFL_SYSTEM_PASS=
# DB_IGANGAOFL_WEBSITE_USER=
# DB_IGANGAOFL_WEBSITE_PASS=

# ── Payment Gateway ──────────────────────────────────────────
# Most provider credentials are stored in the payment_providers
# database table (via the admin panel). The env vars below are
# optional overrides / backup for local development.
#
# PAYMENT_MODE=sandbox          # sandbox | production

# MTN MoMo (Sandbox defaults)
# DB_PAYMENT_MTN_MOMO_API_USER=sandbox_user
# DB_PAYMENT_MTN_MOMO_API_KEY=sandbox_key
# DB_PAYMENT_MTN_MOMO_SUB_KEY=sandbox_sub_key

# Airtel Money (Sandbox defaults)
# DB_PAYMENT_AIRTEL_CLIENT_ID=sandbox_id
# DB_PAYMENT_AIRTEL_CLIENT_SECRET=sandbox_secret

# Stripe
# DB_PAYMENT_STRIPE_SECRET_KEY=sk_test_...
# DB_PAYMENT_STRIPE_PUBLISHABLE_KEY=pk_test_...
# DB_PAYMENT_STRIPE_WEBHOOK_SECRET=whsec_...

# Flutterwave
# DB_PAYMENT_FLW_SECRET_KEY=FLWSECK-...
# DB_PAYMENT_FLW_PUBLIC_KEY=FLWPUBK-...

# PesaPal
# DB_PAYMENT_PESAPAL_CONSUMER_KEY=...
# DB_PAYMENT_PESAPAL_CONSUMER_SECRET=...

# PayPal
# DB_PAYMENT_PAYPAL_CLIENT_ID=...
# DB_PAYMENT_PAYPAL_CLIENT_SECRET=...
# DB_PAYMENT_PAYPAL_WEBHOOK_ID=...
